# WAHA - WhatsApp HTTP API
#
# https://waha.devlike.pro/docs/how-to/config/
#

# ====================
# ===== SECURITY =====
# ====================
WAHA_API_KEY=00000000000000000000000000000000
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=11111111111111111111111111111111
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=11111111111111111111111111111111

# Disable Dashboard or Swagger
WAHA_DASHBOARD_ENABLED=True
WHATSAPP_SWAGGER_ENABLED=True

# ==================
# ===== COMMON =====
# ==================
# WhatsApp engine (WEBJS is default, GOWS or NOWEB for better performance)
WHATSAPP_DEFAULT_ENGINE=WEBJS

# WAHA_CLIENT_DEVICE_NAME=YourApp

# ===== NOWEB session longevity / anti-detection =====
# Periodic forced socket restart (minutes). 0 = disabled (recommended).
# A real companion device holds a persistent connection; timer-based restarts are
# bot-like churn that HURT longevity. Upstream WAHA added then removed this.
# Only set >0 as a last resort if you observe genuine auth-persistence drops.
WAHA_NOWEB_AUTO_RESTART_MINUTES=0
# Per-session markOnline now defaults to FALSE (set in session config, not here):
# keep the account from appearing perpetually online (a bot signal) and let the
# primary phone keep receiving notifications. Override per session via
# session.config.noweb.markOnline only if you specifically need it.

# Base URL for the API (used for webhooks, file URLs, etc.)
WAHA_BASE_URL=http://localhost:3000
# WAHA_PUBLIC_URL=http://localhost:3000

# Server configuration (if you need to customize hostname/port)
# WHATSAPP_API_SCHEMA=http
# WHATSAPP_API_PORT=3000
# WHATSAPP_API_HOSTNAME=localhost


# ===================
# ====== GOWS =======
# ===================
# By default, GOWS uses cgo (libc) DNS resolver
# You can ask to use golang one, but it's less reliable
# GODEBUG=netdns=go

# ===================
# ===== LOGGING =====
# ===================
# Log format: JSON (for log management systems) or PRETTY (for development)
WAHA_LOG_FORMAT=JSON

# Log level: info, debug, error, warn
WAHA_LOG_LEVEL=info

# Don't print QR codes in logs
WAHA_PRINT_QR=False

# =========================
# ===== MEDIA STORAGE =====
# =========================
# Local storage (default)
WAHA_MEDIA_STORAGE=LOCAL
WHATSAPP_FILES_LIFETIME=0
WHATSAPP_FILES_FOLDER=/app/.media

# Media download settings
# WHATSAPP_DOWNLOAD_MEDIA=true
# WHATSAPP_FILES_MIMETYPES=image/jpeg,image/png

# S3 storage (uncomment to use)
# WAHA_MEDIA_STORAGE=S3
# WAHA_S3_REGION=eu-west-2
# WAHA_S3_BUCKET=waha
# WAHA_S3_ACCESS_KEY_ID=minioadmin
# WAHA_S3_SECRET_ACCESS_KEY=minioadmin
# WAHA_S3_ENDPOINT=http://minio:9000
# WAHA_S3_FORCE_PATH_STYLE=True
# WAHA_S3_PROXY_FILES=True

# PostgreSQL storage (uncomment to use)
# WAHA_MEDIA_STORAGE=POSTGRESQL
# WAHA_MEDIA_POSTGRESQL_URL=postgres://postgres:postgres@postgres:5432/postgres?sslmode=disable

# ===========================
# ===== SESSION STORAGE =====
# ===========================
# PostgreSQL for sessions (uncomment to use)
# WHATSAPP_SESSIONS_POSTGRESQL_URL=postgres://postgres:postgres@postgres:5432/postgres?sslmode=disable

# MongoDB for sessions (uncomment to use)
# WHATSAPP_SESSIONS_MONGO_URL=mongodb://mongouser:mongopassword@mongodb:27017

# =================
# ===== APPS ======
# =================
# WAHA_APPS_ENABLED=True
# REDIS_URL=redis://:redis@redis:6379

# Apps Jobs configuration - *_AGE in seconds
# WAHA_APPS_JOBS_REMOVE_ON_COMPLETE_AGE=
# WAHA_APPS_JOBS_REMOVE_ON_COMPLETE_COUNT=
# WAHA_APPS_JOBS_REMOVE_ON_FAIL_AGE=
# WAHA_APPS_JOBS_REMOVE_ON_FAIL_COUNT


# ==================================
# ===== ADVANCED CONFIGURATION =====
# ==================================

# Timezone for screenshots and logs
# TZ=Europe/Dublin

# Session management
# WHATSAPP_START_SESSION=session1,session2
# WHATSAPP_RESTART_ALL_SESSIONS=False

# Webhooks
# WHATSAPP_HOOK_URL=https://webhook.site/11111111-1111-1111-1111-11111111
# WHATSAPP_HOOK_CUSTOM_HEADERS=custom_header_key:custom_header_value
# WHATSAPP_HOOK_EVENTS=session.status,message,message.reaction

# Proxy configuration
# WHATSAPP_PROXY_SERVER=proxy.example.com:3128
# WHATSAPP_PROXY_SERVER_USERNAME=user
# WHATSAPP_PROXY_SERVER_PASSWORD=pass

# HTTPS configuration
# !DEPRECATED!
# Setup nginx reverse proxy to handle TLS connection
# using Let's encrypt or self-issued certificate
# WAHA_HTTPS_ENABLED=true
# WAHA_HTTPS_PATH_KEY=/etc/letsencrypt/live/waha.example.pro/privkey.pem
# WAHA_HTTPS_PATH_CERT=/etc/letsencrypt/live/waha.example.pro/cert.pem
# WAHA_HTTPS_PATH_CA=/etc/letsencrypt/live/waha.example.pro/chain.pem

# ==============================
# ===== MULTI-SESSION ==========
# ==============================
# Maximum number of concurrent WhatsApp sessions (default: 20)
WAHA_MAX_SESSIONS=20

# ==============================
# ===== BAN PREVENTION =========
# ==============================
# Enable ban prevention system (requires PostgreSQL)
BAN_PREVENTION_ENABLED=true
BAN_PREVENTION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/waha?sslmode=disable

# Warmup Phase Durations (days) - 21 day total warmup period
# Phase 1: Profile setup only - no messaging allowed
WARMUP_PHASE_1_DAYS=2
# Phase 2: Receive and reply only (max 5 messages/day)
WARMUP_PHASE_2_DAYS=2
# Phase 3: Limited sending (max 40 messages/day)
WARMUP_PHASE_3_DAYS=4
# Phase 4: Gradual increase (max 80 messages/day)
WARMUP_PHASE_4_DAYS=13

# Message Limits Per Warmup Phase
WARMUP_PHASE_1_MAX_DAILY=0
WARMUP_PHASE_2_MAX_DAILY=5
WARMUP_PHASE_3_MAX_DAILY=40
WARMUP_PHASE_4_MAX_DAILY=80
WARMUP_COMPLETED_MAX_DAILY=100

# Rate Limiting
# Maximum messages to a single recipient per day
MAX_MESSAGES_PER_RECIPIENT_PER_DAY=15
# Minimum interval between messages to the same recipient (milliseconds)
MIN_INTERVAL_BETWEEN_MESSAGES_MS=180000
# Random delay before sending each message (milliseconds) - simulates human behavior
RANDOM_DELAY_MIN_MS=2000
RANDOM_DELAY_MAX_MS=5000

# Multiple Proxy Configuration (for distributing sessions across proxies)
# Comma-separated list of proxy servers
# WHATSAPP_PROXY_SERVER_LIST=proxy1.example.com:3128,proxy2.example.com:3128,proxy3.example.com:3128
# Prefix to extract proxy index from session name (e.g., session_1 uses proxy index 1)
# WHATSAPP_PROXY_SERVER_INDEX_PREFIX=session_

# ============================================================
# TS-BRIDGE FAILOVER (Tailscale exit-node sidecar + watchdog)
# All of these are injected via Coolify env in production.
# See docs/superpowers/specs/2026-07-13-tailscale-exit-node-failover.md
# ============================================================
# Tailscale auth key for the ts-bridge sidecar (reusable, no/long expiry)
# TS_AUTHKEY=tskey-auth-xxxxx
# Phone 1 Tailscale IP (100.x.y.z) — preferred India 4G exit node
# PHONE_TS_IP=100.64.0.1
# Phone 2 Tailscale IP — optional backup exit node (leave unset to skip tier)
# PHONE_TS_IP_2=100.64.0.2
# Postgres URL for failover/probe logging (only remote observability channel)
# BAN_PREVENTION_DATABASE_URL=postgres://user:pass@host:5432/db
# WAHA_API_KEY above is reused by the watchdog to restart sessions after a switch.
# If WAHA_API_KEY is stored HASHED (sha512:...), also set the plain key here —
# the watchdog makes real API calls and cannot authenticate with the hash:
# WAHA_API_KEY_PLAIN=your_plain_api_key

# Watchdog tuning (defaults shown — usually leave alone)
# Seconds between health checks of the active egress path
# FAILOVER_CHECK_INTERVAL=20
# Consecutive failures before demoting to the next tier (~60-75s outage)
# FAILOVER_FAIL_THRESHOLD=3
# Consecutive online checks a recovered phone needs before promotion (15 = 5 min)
# FAILOVER_RECOVERY_CHECKS=15
# Minimum seconds on the current path before any promotion (anti-churn dampener)
# FAILOVER_MIN_DWELL=1800
# Seconds a phone is banned from promotion after a failed switch attempt
# FAILOVER_QUARANTINE=3600
# Space-separated egress-IP probe URLs; path counts as dead only if ALL fail
# (one probe service outage must never trigger a failover)
# FAILOVER_CHECK_URLS=https://api.ipify.org https://checkip.amazonaws.com https://ifconfig.me/ip
